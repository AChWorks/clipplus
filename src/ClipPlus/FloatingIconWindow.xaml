<Window x:Class="ClipPlus.FloatingIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipPlus floating clipboard"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Topmost="True" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/ClipPlusIcon.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- The shape is a local visual resource, not a persisted setting.
                 The visual acceptance test renders both requested alternatives. -->
            <CornerRadius x:Key="FloatingRadius">10</CornerRadius>
        </ResourceDictionary>
    </Window.Resources>
    <Button x:Name="FloatingButton" Focusable="False" Cursor="Hand"
            AutomationProperties.Name="Open pinned clipboard"
            ToolTip="Click to open; drag to move"
            Background="{DynamicResource FloatingSurfaceBrush}"
            BorderBrush="{DynamicResource FloatingOutlineBrush}" BorderThickness="1">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <!-- A single surface; no nested solid blue app tile. -->
                <Border x:Name="Surface" CornerRadius="{DynamicResource FloatingRadius}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <Rectangle Width="38" Height="38" Fill="{DynamicResource FloatingGlyphBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{StaticResource ClipPlusFloatingGlyph}" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Border>
            </ControlTemplate>
        </Button.Template>
    </Button>
</Window>
