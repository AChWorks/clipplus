<Window x:Class="ClipPlus.FloatingIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipPlus floating clipboard"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Topmost="True" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/ClipPlusIcon.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Button x:Name="FloatingButton" Focusable="False" Cursor="Hand"
            AutomationProperties.Name="Open pinned clipboard"
            ToolTip="Click to open; drag to move"
            BorderThickness="0" Padding="0">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <!-- One borderless circular alpha surface, with the canonical
                     clipboard glyph instead of a second, opaque app tile. -->
                <Grid>
                    <Ellipse x:Name="Surface" Fill="{TemplateBinding Background}"/>
                    <Rectangle Width="38" Height="38" Fill="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{StaticResource ClipPlusFloatingGlyph}" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Grid>
            </ControlTemplate>
        </Button.Template>
    </Button>
</Window>
