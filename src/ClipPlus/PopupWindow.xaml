<Window x:Class="ClipPlus.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ClipPlus" Icon="Assets/ClipPlus.ico" Width="360" Height="520" MinHeight="240"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Topmost="True" Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0,6,0,6"
                            GlassFrameThickness="0" CornerRadius="8" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource FocusBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClipCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="11,9,11,7">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="28" ToolTip="Close (Esc)"
                        AutomationProperties.Name="Close clipboard" Content="&#x2715;"/>
                <Button x:Name="ClearButton" DockPanel.Dock="Right" ToolTip="Clear recent items; keep pinned items"
                        AutomationProperties.Name="Clear recent items" Content="Clear"/>
                <Border x:Name="DragHeader" Background="Transparent" Cursor="SizeAll" ToolTip="Drag to move"
                        AutomationProperties.Name="Move clipboard window">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/ClipPlus.ico" Width="19" Height="19" Margin="0,0,7,0"/>
                        <TextBlock Text="Clipboard" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,0,0,9">
                <TextBox x:Name="SearchBox" Height="34" Padding="28,5,6,5"
                         AutomationProperties.Name="Search clipboard" ToolTip="Search titles and clipboard text"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="9,0,0,0"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock x:Name="SearchPlaceholder" Text="Search clipboard..." Margin="30,0,0,0"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <Grid Grid.Row="2">
                <ListBox x:Name="ClipList" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource TextBrush}" Padding="0,0,3,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         AutomationProperties.Name="Clipboard history">
                    <ListBox.Resources>
                        <!-- Keep the native WPF ScrollBar/Track/Thumb behavior.
                             Windows 11-style indicator: thin at rest, wider on hover,
                             with a comfortable invisible pointer target. -->
                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="Width" Value="12"/>
                            <Setter Property="MinWidth" Value="12"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                                            <Border x:Name="ScrollRail" Width="8" CornerRadius="4"
                                                    HorizontalAlignment="Center" Background="{DynamicResource ScrollRailBrush}"
                                                    Opacity="0"/>
                                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Background="Transparent">
                                                        <RepeatButton.Template>
                                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                                <Border Background="Transparent"/>
                                                            </ControlTemplate>
                                                        </RepeatButton.Template>
                                                    </RepeatButton>
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb MinHeight="22" Focusable="False">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Grid Background="Transparent">
                                                                    <Border x:Name="ScrollIndicator" Width="{DynamicResource ScrollIndicatorWidth}" CornerRadius="3"
                                                                            HorizontalAlignment="Center" Background="{DynamicResource ScrollThumbBrush}"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" Value="True">
                                                                        <Setter TargetName="ScrollIndicator" Property="Width" Value="{DynamicResource ScrollIndicatorActiveWidth}"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsDragging" Value="True">
                                                                        <Setter TargetName="ScrollIndicator" Property="Width" Value="{DynamicResource ScrollIndicatorActiveWidth}"/>
                                                                        <Setter TargetName="ScrollIndicator" Property="Background" Value="{DynamicResource ScrollActiveBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Background="Transparent">
                                                        <RepeatButton.Template>
                                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                                <Border Background="Transparent"/>
                                                            </ControlTemplate>
                                                        </RepeatButton.Template>
                                                    </RepeatButton>
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ScrollRail" Property="Opacity" Value="1"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                </ListBox>
                <TextBlock x:Name="EmptyLabel" Text="Nothing copied yet." TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="StatusLabel" Grid.Row="3" TextWrapping="Wrap" MaxHeight="48"
                       Foreground="{DynamicResource TextBrush}" Visibility="Collapsed" Margin="0,4,0,2"
                       AutomationProperties.LiveSetting="Polite"/>
            <DockPanel Grid.Row="4" Margin="0,5,0,0">
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11" Text="&#x2195; Resize"/>
                <TextBlock x:Name="FooterLabel" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                           Text="&#x2191; &#x2193; Navigate  ·  Enter Paste"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
