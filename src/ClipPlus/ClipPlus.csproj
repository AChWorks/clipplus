<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/ClipPlus.ico</ApplicationIcon>
    <!-- A published elevated application must not use a user-selected DOTNET_ROOT. -->
    <AppHostDotNetSearch>Global</AppHostDotNetSearch>
    <!-- WPF owns process DPI awareness through the manifest. WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/ClipPlus.ico"/>
    <ProjectReference Include="../ClipPlus.Core/ClipPlus.Core.csproj" />
    <!-- Installed elevated builds do not load managed startup hooks from environment settings. -->
    <RuntimeHostConfigurationOption Include="System.StartupHookProvider.IsSupported" Value="false" />
  </ItemGroup>
</Project>
